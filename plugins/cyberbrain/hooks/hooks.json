{
  "description": "Cyberbrain: the lifecycle hooks `cyberbrain install` writes, run through the plugin's starter; session start as two hooks (each has its own 10,000-character cap), a 30 s timeout on each, and a mod (register.js) for the compaction notice and /recall.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook session-rings",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook session-context",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook pre-tool-use",
            "timeout": 30
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|WebFetch"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook post-tool-use",
            "timeout": 30
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cyberbrain\" hook pre-compact",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.js"
  ]
}
